<script>
// ===== Navbar hiển thị Admin + Doanh thu + Đăng xuất =====
window.addEventListener('DOMContentLoaded', () => {
    // Luôn hiển thị Doanh thu + Đăng xuất vì người dùng đã pass kiểm tra PHP
    document.getElementById('loginLink').style.display = 'none';
    document.getElementById('logoutBtn').style.display = 'inline-block';
    
    // Load tất cả dữ liệu
    loadProducts();
    loadCustomers();
    loadRevenue();
    
    // Gạch chân menu đang ở
    const navLinks = document.querySelectorAll('header nav a');
const currentPath = window.location.pathname.split("/").pop();
    navLinks.forEach(link => {
        const href = link.getAttribute('href');
        if(href === currentPath || (href === "#menu" && currentPath === "index.php")) {
            link.classList.add('active');
        } else {
            link.classList.remove('active');
        }
    });
});

function dangXuat() {
    window.location.href = 'logout.php';
}

// ===== Quản lý sản phẩm =====
function loadProducts(){
    fetch('api_products.php')
    .then(r => r.json())
    .then(products => {
        let html = '';
        if(products.length === 0) {
            html = '<tr><td colspan="3" style="text-align:center;">Không có sản phẩm</td></tr>';
        } else {
            products.forEach((p) => {
                html += `<tr>
                    <td>${p.name}</td>
                    <td>${parseInt(p.price)}₫</td>
                    <td>
                        <button class="edit" onclick="editProduct(${p.id}, '${p.name}', ${p.price})">Sửa</button>
                        <button class="delete" onclick="deleteProduct(${p.id})">Xóa</button>
                    </td>
                </tr>`;
            });
        }
        document.getElementById('product-list').innerHTML = html;
    })
    .catch(error => {
        console.error('Lỗi:', error);
        document.getElementById('product-list').innerHTML = '<tr><td colspan="3" style="color:red;">Lỗi tải dữ liệu</td></tr>';
    });
}

function addProduct(){
    let name = prompt('Tên sản phẩm:');
    if (!name) return;
    
    let price = prompt('Giá sản phẩm:');
    if (!price || isNaN(price)) {
        alert('Giá không hợp lệ');
        return;
    }
    
    let image = prompt('Link hình ảnh:', 'images/placeholder.jpg');

    fetch('api_add_product.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            name: name,
            price: parseFloat(price),
            image: image || 'images/placeholder.jpg'
        })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            alert('✓ Thêm sản phẩm thành công!');
            loadProducts();
        } else {
            alert('✗ Lỗi: ' + (data.error || 'Không rõ'));
        }
    })
    .catch(error => alert('✗ Lỗi: ' + error));
}

function editProduct(id, currentName, currentPrice){
    let name = prompt('Tên mới:', currentName);
    if (!name) return;
    
    let price = prompt('Giá mới:', currentPrice);
    if (!price || isNaN(price)) {
        alert('Giá không hợp lệ');
        return;
    }

    fetch('api_edit_product.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            id: id,
            name: name,
            price: parseFloat(price)
        })
    })
    .then(r => r.json())
    .then(data => {
if (data.success) {
            alert('✓ Cập nhật sản phẩm thành công!');
            loadProducts();
        } else {
            alert('✗ Lỗi: ' + (data.error || 'Không rõ'));
        }
    })
    .catch(error => alert('✗ Lỗi: ' + error));
}

function deleteProduct(id){
    if(!confirm('Bạn chắc chắn muốn xóa sản phẩm này?')) return;

    fetch('api_delete_product.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            alert('✓ Xóa sản phẩm thành công!');
            loadProducts();
        } else {
            alert('✗ Lỗi: ' + (data.error || 'Không rõ'));
        }
    })
    .catch(error => alert('✗ Lỗi: ' + error));
}

// ===== Quản lý khách hàng =====
function loadCustomers(){
    fetch('api_customers.php')
    .then(r => r.json())
    .then(customers => {
        let html = '';
        if(customers.length === 0) {
            html = '<tr><td colspan="3" style="text-align:center;">Không có khách hàng</td></tr>';
        } else {
            customers.forEach(c => {
                html += `<tr>
                    <td>${c.name}</td>
                    <td>${c.email || c.phone || 'N/A'}</td>
                    <td>${c.address || 'N/A'}</td>
                </tr>`;
            });
        }
        document.getElementById('customer-list').innerHTML = html;
    })
    .catch(error => console.error('Lỗi khách hàng:', error));
}

// ===== Quản lý doanh thu (Đơn hàng + Chi tiết) =====
function loadRevenue(){
    fetch('api_revenue.php')
    .then(r => r.json())
    .then(orders => {
        let html = '';
        if(orders.length === 0) {
            html = '<tr><td colspan="5" style="text-align:center;">Không có đơn hàng</td></tr>';
        } else {
            orders.forEach(o => {
                html += `<tr>
                    <td>${o.date}</td>
                    <td>${o.customer}</td>
                    <td>${o.product}</td>
                    <td>${parseInt(o.price)}₫</td>
                    <td>${o.payment}</td>
                </tr>`;
            });
        }
        document.getElementById('revenue-list').innerHTML = html;
    })
    .catch(error => console.error('Lỗi doanh thu:', error));
}
